---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';

const people = (await getCollection('people')).sort((a, b) => a.data.order - b.data.order);
---

<Base title="People" description="The six founders of the Zurich Institute.">
  <div class="wrap">
    <header class="intro">
      <p class="label">People</p>
      <h1>Six founders, one question: how do people keep the power to choose?</h1>
    </header>

    <ul class="people">
      {
        people.map((p) => (
          <li id={p.id}>
            {p.data.photo ? (
              <img src={p.data.photo} alt={`Portrait of ${p.data.name}`} width="800" height="800" loading="lazy" />
            ) : (
              <div class="tile" aria-hidden="true">
                <span>{p.data.initials}</span>
              </div>
            )}
            <h2>{p.data.name}</h2>
            <p class="meta role">{p.data.role}</p>
            <p class="bio">{p.data.bio}</p>
            {p.data.links.length > 0 && (
              <p class="meta links">
                {p.data.links.map((l) => (
                  <a href={l.url} rel="noopener">
                    {l.label}
                  </a>
                ))}
              </p>
            )}
          </li>
        ))
      }
    </ul>
  </div>
</Base>

<style>
  .intro {
    padding-block: clamp(3rem, 9vw, 6rem) clamp(2.5rem, 6vw, 4rem);
    border-bottom: 1px solid var(--rule);
  }
  .intro h1 {
    margin-top: 1.25rem;
    font-size: clamp(1.9rem, 4.2vw, 3.2rem);
    line-height: 1.12;
    font-weight: 360;
    letter-spacing: -0.02em;
    max-width: 22ch;
  }
  .people {
    list-style: none;
    margin: 0;
    padding: clamp(2.5rem, 6vw, 4rem) 0 0;
    display: grid;
    gap: 3.5rem 3rem;
  }
  @media (min-width: 640px) {
    .people {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (min-width: 1040px) {
    .people {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
  .tile,
  img {
    aspect-ratio: 1;
    width: 100%;
    max-width: 22rem;
    margin-bottom: 1.25rem;
    background: var(--tile);
    object-fit: cover;
  }
  .tile {
    display: flex;
    align-items: flex-end;
    padding: 1.25rem;
  }
  .tile span {
    font-size: 3.5rem;
    line-height: 1;
    font-weight: 330;
    letter-spacing: -0.02em;
    color: var(--ink-2);
  }
  h2 {
    font-size: 1.6rem;
  }
  .role {
    margin: 0.35rem 0 0.9rem;
  }
  .bio {
    font-size: 1.02rem;
    line-height: 1.55;
  }
  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 1rem;
    margin: 0;
  }
</style>
