---
import Base from '../layouts/Base.astro';
import EssayList from '../components/EssayList.astro';
import ConcernContribution from '../components/ConcernContribution.astro';
import Figure from '../components/Figure.astro';
import { getEssays } from '../lib/essays';
import { mission, method, tagline, name } from '../data/institute';

const essays = (await getEssays()).slice(0, 3);

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name,
  url: Astro.site?.toString(),
  logo: new URL('/apple-touch-icon.png', Astro.site).toString(),
  description: mission,
};
---

<Base description={tagline} jsonLd={jsonLd}>
  <section class="wrap hero">
    <h1>
      The Zurich Institute envisions a <span class="accent">high-agency society</span> with the knowledge
      and technology to pursue prosperity, meaning, and abundance.
    </h1>
  </section>

  <div class="wrap">
    <Figure
      class="lead-image"
      stem="zurich-1890s"
      widths={[640, 1024]}
      width={1024}
      height={772}
      sizes="(min-width: 76rem) 1024px, 100vw"
      loading="eager"
      alt="Colour photochrom of Zurich's Bahnhofplatz in the 1890s: the railway station on the left, a fountain and pedestrians in the square, and the long Polytechnikum building on the hill behind."
    >
      Zurich, Bahnhofplatz and the Polytechnikum, 1890s. The building on the hill is now ETH Zurich's
      main building. Photochrom, a colour process developed in Zurich. <a
        href="https://www.loc.gov/pictures/item/93506994/">Library of Congress</a
      >, no known restrictions.
    </Figure>
  </div>

  <section class="band-soft" aria-labelledby="mission">
    <div class="wrap row">
      <h2 class="label" id="mission">Mission</h2>
      <div>
        <p class="lede">{mission}</p>
        <p class="meta"><a href="/about/">Read our principles</a></p>
      </div>
    </div>
  </section>

  <div class="wrap">
    <section class="row cc-row">
      <ConcernContribution />
    </section>

    <section class="row" aria-labelledby="method">
      <h2 class="label" id="method">Method</h2>
      <ol class="method">
        {
          method.map((m, i) => (
            <li>
              <span class="num meta">0{i + 1}</span>
              <h3>{m.title}</h3>
              <p>{m.text}</p>
            </li>
          ))
        }
      </ol>
    </section>

    <section class="row" aria-labelledby="writing">
      <h2 class="label" id="writing">Writing</h2>
      <div>
        <EssayList essays={essays} />
        <p class="meta more"><a href="/writing/">All writing</a></p>
      </div>
    </section>

    <section class="row" aria-labelledby="people">
      <h2 class="label" id="people">People</h2>
      <div>
        <p class="prose">
          Six engineers, architects, scientists, and founders working across research and industry,
          from building heritage and circular construction to diagnostics, spacecraft, and applied AI.
        </p>
        <p class="meta"><a href="/people/">Meet the founders</a></p>
      </div>
    </section>
  </div>
</Base>

<style>
  .hero {
    padding-block: clamp(3.5rem, 10vw, 7.5rem) clamp(2.5rem, 6vw, 4.5rem);
  }
  .hero h1 {
    font-size: clamp(2.1rem, 5.4vw, 4.4rem);
    line-height: 1.06;
    font-weight: 360;
    letter-spacing: -0.022em;
    max-width: 19ch;
  }
  .hero .accent {
    font-style: italic;
  }
  .wrap :global(.lead-image) {
    margin-bottom: clamp(3rem, 8vw, 5rem);
  }
  .cc-row {
    display: block;
    border-top: 0;
  }
  .method {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 2rem;
  }
  @media (min-width: 700px) {
    .method {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
  .method h3 {
    font-size: 1.6rem;
    margin: 0.4rem 0 0.5rem;
  }
  .method p {
    margin: 0;
    color: var(--ink-2);
    font-size: 1.05rem;
  }
  .num {
    display: block;
    border-top: 2px solid var(--accent);
    padding-top: 0.6rem;
    color: var(--accent);
    font-weight: 600;
  }
  .more {
    margin-top: 2.5rem;
  }
</style>
