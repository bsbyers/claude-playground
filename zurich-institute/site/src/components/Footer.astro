---
import { tagline } from '../data/institute';
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="wrap cols">
    <p class="tag">{tagline}</p>
    <p class="meta">
      Our writing is versioned. Every version stays online, so what we said and when stays on the
      record.
    </p>
    <p class="meta links">
      <a href="/rss.xml">RSS</a>
      <span aria-hidden="true">·</span>
      <span>© {year} Zurich Institute</span>
    </p>
  </div>
</footer>

<style>
  .site-footer {
    margin-top: clamp(4rem, 10vw, 8rem);
    padding-block: 2.5rem 3rem;
    background: var(--band);
    color: var(--band-ink);
  }
  .cols {
    display: grid;
    gap: 1rem 3rem;
  }
  .site-footer .meta {
    color: var(--band-ink-2);
  }
  .site-footer a {
    color: var(--band-ink);
    text-decoration-color: var(--band-ink-2);
  }
  .site-footer a:hover {
    color: var(--band-ink);
    text-decoration-color: var(--band-ink);
  }
  @media (min-width: 860px) {
    .cols {
      grid-template-columns: var(--label) minmax(0, 28rem) 1fr;
    }
    .links {
      justify-self: end;
    }
  }
  p {
    margin: 0;
  }
  .tag {
    font-size: 0.95rem;
    line-height: 1.4;
  }
  .links {
    display: flex;
    gap: 0.5rem;
  }
</style>
