---
// A responsive image from public/images/<stem>-<width>.{webp,jpg}.
interface Props {
  stem: string;
  widths: number[];
  /** Intrinsic width and height of the largest file, for layout stability. */
  width: number;
  height: number;
  alt: string;
  sizes?: string;
  loading?: 'lazy' | 'eager';
  class?: string;
}
const { stem, widths, width, height, alt, sizes = '100vw', loading = 'lazy', class: cls } = Astro.props;
const set = (ext: string) => widths.map((w) => `/images/${stem}-${w}.${ext} ${w}w`).join(', ');
const largest = Math.max(...widths);
---

<figure class={cls}>
  <picture>
    <source type="image/webp" srcset={set('webp')} sizes={sizes} />
    <img
      src={`/images/${stem}-${largest}.jpg`}
      srcset={set('jpg')}
      sizes={sizes}
      width={width}
      height={height}
      alt={alt}
      loading={loading}
      decoding="async"
    />
  </picture>
  <figcaption><slot /></figcaption>
</figure>
